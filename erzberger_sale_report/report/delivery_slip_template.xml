   <xpath expr="//table[@class='company_header table-borderless']" position="replace">

    <table width="100%" class="company_header table-borderless" t-att-style="'height: %dmm;' % (din_header_spacing or 27)">

        <tr>

            <!-- ================================================= -->
            <!-- LEFT: COMPANY ADDRESS -->
            <!-- ================================================= -->
            <td width="60%" style="text-align:left;           padding-left:20px;              vertical-align:top;">

                <div class="colored_address" style="padding-top:255px;                           text-align:left;                             white-space:nowrap;                             display:inline-block;                             font-size:10px;                             color:#315d35;                             font-weight:600;                             border-bottom:1px solid #315d35;                             padding-bottom:2px;">

                    <t t-if="company.name">
                        <span t-field="company.name"/>
                    </t>

                    <t t-if="company.street">
                        <span>|</span>
                        <span t-field="company.street"/>
                    </t>

                    <t t-if="company.street2">
                        <span>|</span>
                        <span t-field="company.street2"/>
                    </t>

                    <t t-if="company.zip">
                        <span>|</span>
                        <span t-field="company.zip"/>
                    </t>

                    <t t-if="company.city">
                        <span t-if="not company.zip">|</span>
                        <span t-field="company.city"/>
                    </t>

                    <t t-if="company.country_id">
                        <span>|</span>
                        <span t-field="company.country_id.name"/>
                    </t>

                </div>

            </td>


            <!--<td width="20%" style="text-align:center;                        vertical-align:top;">-->

            <!--    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="height:50mm;                             width:40mm;                             display:block;                             margin:0 auto;"/>-->

            <!--    <div style="text-align:right;                             margin-top:2mm;                             line-height:1.15;">-->
            <!--        <span style="font-size:11px;                                  color:#315d35;">Inhaber: Jens Kriegel</span><br/>-->
            <!--        <span style="font-size:11px;                                  color:#315d35;                                  font-weight:700;                                  text-align:center;                                  display:block;">-->
            <!--            Handwerkliche<br/>-->
            <!--            Holzkunst aus<br/>-->
            <!--            dem Erzgebirge-->
            <!--        </span>-->

            <!--    </div>-->

            <!--</td>-->
            <td width="20%" style="text-align:center;            vertical-align:top;">

    <!-- Main Company Logo -->
    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="height:46mm;                 width:42mm;                 display:block;                 margin:0 auto;"/>

    <!-- Inhaber -->
    <div style="width:100%;                 text-align:center;                 margin-top:1mm;                 line-height:1.2;">

        <span style="font-size:11px;                      color:#315d35;                      font-weight:600;                      text-align:center;                      display:block;">
            Inhaber: Jens Kriegel
        </span>

    </div>

    <!-- Handwerkliche Holzkunst -->
    <div style="width:100%;                 text-align:center;                 margin-top:3mm;                 line-height:1.15;">

        <span style="font-size:11px;                      color:#315d35;                      font-weight:700;                      text-align:center;                      display:block;">
            Handwerkliche<br/>
            Holzkunst aus<br/>
            dem Erzgebirge
        </span>

    </div>

</td>

            <!-- ================================================= -->
            <!-- RIGHT: ADDITIONAL LOGOS -->
            <!-- ================================================= -->
            <td width="20%" style="text-align:right; padding-top:10px;                       vertical-align:top;">

                <img src="/erzberger_sale_report/static/src/img/img_7.png" style="height:30mm;                             width:25mm;                             display:block;                             margin-left:auto;"/>

