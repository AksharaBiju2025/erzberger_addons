<xpath expr="//div[contains(@class, 'footer') or contains(@t-attf-class, 'footer')]" position="replace">

    <div class="din_page footer" style="background:transparent;                 background-color:transparent;                 color:#315d35;                 padding:0;                 margin:0;                 font-size:8px;                 width:100%;">

        <table class="footer_table table-borderless" style="width:100%;                       border-collapse:collapse;                       border-spacing:0;                       background:transparent;                       background-color:transparent;                       color:#315d35;                       margin:0;                       padding:0;                       table-layout:fixed;">

            <tr>

                <td style="width:25%;                            padding:0 5px 0 5px;                            border-right:1px solid #9bb39c;                            vertical-align:top;                            background:transparent;                            color:#315d35;">

                    <strong style="font-size:9px;                                    font-weight:700;                                    color:#315d35;                                    display:block;                                    margin:0;                                    padding:0;                                    line-height:1.15;">
                        Fachgeschäft:
                    </strong>

                    <div style="font-size:8px;                                 color:#315d35;                                 line-height:1.20;                                 margin:1px 0 0 0;                                 padding:0;">

                        <div t-field="company.name"/>

                        <div t-if="company.street" t-field="company.street"/>

                        <div t-if="company.street2" t-field="company.street2"/>

                        <div>
                            <span t-if="company.zip" t-field="company.zip"/>

                            <t t-if="company.zip and company.city">
                                <span> </span>
                            </t>

                            <span t-if="company.city" t-field="company.city"/>
                        </div>

                        <div t-if="company.country_id" t-field="company.country_id.name"/>

                    </div>

                </td>


                  
                <td style="width:25%;                            padding:0 5px 0 10px;                            border-right:1px solid #9bb39c;                            vertical-align:top;                            background:transparent;                            color:#315d35;">

                    <strong style="font-size:9px;                                    font-weight:700;                                    color:#315d35;                                    display:block;                                    margin:0;                                    padding:0;                                    line-height:1.15;">
                        Büro:
                    </strong>

                    <div style="font-size:8px;                                 color:#315d35;                                 line-height:1.20;                                 margin:1px 0 0 0;                                 padding:0;">

                        <div t-if="company.partner_id" t-field="company.partner_id.name"/>

                        <div t-if="company.partner_id.street" t-field="company.partner_id.street"/>

                        <div t-if="company.partner_id.street2" t-field="company.partner_id.street2"/>

                        <div>
                            <span t-if="company.partner_id.zip" t-field="company.partner_id.zip"/>

                            <t t-if="company.partner_id.zip and company.partner_id.city">
                                <span> </span>
                            </t>

                            <span t-if="company.partner_id.city" t-field="company.partner_id.city"/>
                        </div>

                        <div t-if="company.partner_id.country_id" t-field="company.partner_id.country_id.name"/>

                    </div>

                </td>


                  
                <td style="width:25%;                            padding:0 5px 0 10px;                            border-right:1px solid #9bb39c;                            vertical-align:top;                            background:transparent;                            color:#315d35;">

                    <strong style="font-size:9px;                                    font-weight:700;                                    color:#315d35;                                    display:block;                                    margin:0;                                    padding:0;                                    line-height:1.15;">
                        Kontakt:
                    </strong>

                    <div style="font-size:8px;                                 color:#315d35;                                 line-height:1.20;                                 margin:1px 0 0 0;                                 padding:0;">

                        <div t-if="company.phone">
                            Telefon: <span t-field="company.phone"/>
